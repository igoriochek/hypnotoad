APP_NAME=shkelio-backend
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Frontend URL (for CORS, redirects)
FRONTEND_URL=https://shkelio.com

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shkelio
DB_USERNAME=root
DB_PASSWORD=

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=noreply@shkelio.com
MAIL_FROM_NAME="${APP_NAME}"

# ──────────────────────────────────────────────────────
# Payment provider configuration
# ──────────────────────────────────────────────────────
# Choose one: montonio, paysera, makecommerce
PAYMENT_PROVIDER=paysera

# Provider-specific API URLs (defaults are set in config/payments.php)
# Montonio: https://api.montonio.com
# Paysera:  WebToPay redirect (no API URL needed)
# MakeCommerce: https://api.makecommerce.net
# PAYMENT_API_URL=

# API credentials — REAL VALUES MUST BE HOSTING SECRETS, NEVER IN GIT
PAYMENT_ACCESS_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Paysera WebToPay credentials - from Paysera project settings page
PAYSERA_PROJECT_ID=
PAYSERA_PROJECT_PASSWORD=
PAYSERA_TEST=1

# Where to send order notifications (Oksana)
ORDER_NOTIFICATION_EMAIL=roxana71@protonmail.com

# Payment return URLs (defaults use APP_URL)
# PAYMENT_RETURN_SUCCESS=
# PAYMENT_RETURN_CANCELLED=

# ──────────────────────────────────────────────────────
# SANDBOX / TEST MODE
# ──────────────────────────────────────────────────────
# Use provider sandbox URLs for testing before going live.
# Montonio sandbox:    https://sandbox-api.montonio.com
# Paysera test mode:   PAYSERA_TEST=1 (fake payments, no real money)
# MakeCommerce sandbox: https://api.sandbox.makecommerce.net
