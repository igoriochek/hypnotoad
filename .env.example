# Laravel mokėjimų backend API adresas.
# Mokėjimų slapti nustatymai yra backend/.env.example — niekada ne frontend kode.
NEXT_PUBLIC_API_URL=http://localhost:8000


# Būsimos mokėjimų integracijos pavyzdžiai.
 # Tikros reikšmės saugomos hosting o secrets, niekada ne Git saugykloje.
